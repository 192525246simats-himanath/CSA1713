from collections import deque

start = (3, 3, 1)
goal = (0, 0, 0)
moves = [(1,0), (2,0), (0,1), (0,2), (1,1)]

q = deque([(start, [start])])
visited = {start}

while q:
    (m, c, b), path = q.popleft()

    if (m, c, b) == goal:
        print("Solution:")
        for x in path:
            print(x)
        break

    for dm, dc in moves:
        if b:
            new = (m-dm, c-dc, 0)
        else:
            new = (m+dm, c+dc, 1)

        nm, nc, nb = new

        if 0 <= nm <= 3 and 0 <= nc <= 3:
            if (nm == 0 or nm >= nc) and \
               (3-nm == 0 or 3-nm >= 3-nc):
                if new not in visited:
                    visited.add(new)
                    q.append((new, path + [new]))
