import heapq

graph = {
    'A': [('B', 1), ('C', 3)],
    'B': [('D', 3)],
    'C': [('D', 1)],
    'D': []
}

h = {'A': 4, 'B': 3, 'C': 1, 'D': 0}

def astar(start, goal):
    q = [(h[start], 0, start, [start])]

    while q:
        f, g, node, path = heapq.heappop(q)

        if node == goal:
            return path, g

        for next_node, cost in graph[node]:
            new_g = g + cost
            new_f = new_g + h[next_node]

            heapq.heappush(
                q, (new_f, new_g, next_node,
                    path + [next_node])
            )

path, cost = astar('A', 'D')

print("Path:", path)
print("Cost:", cost)
